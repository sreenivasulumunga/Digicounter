rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Subscription/user records
    match /users/{uid} {
      // Users can only read their own record
      allow read: if request.auth != null && request.auth.uid == uid;

      // Users can create their own record, but only in the "none" state
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.status == 'none';

      // Users can update their own record in two safe cases only:
      //  A) "Heartbeat" writes (like device tracking) that don't touch status or expiryDate at all.
      //  B) Submitting a new payment request (status -> "pending"), which never sets expiryDate.
      // They can NEVER set status to "active" or write expiryDate themselves — only the admin can.
      allow update: if request.auth != null && request.auth.uid == uid && (
        (
          request.resource.data.status == resource.data.status &&
          (!('expiryDate' in request.resource.data) ||
           request.resource.data.expiryDate == resource.data.expiryDate)
        ) ||
        (
          request.resource.data.status == 'pending' &&
          resource.data.status in ['none', 'pending'] &&
          (!('expiryDate' in request.resource.data) ||
           request.resource.data.expiryDate == resource.data.expiryDate)
        )
      );

      // The admin account can read/write everything (approve, reject, revoke, etc.)
      allow read, write: if request.auth != null
                          && request.auth.token.email == 'sreenivasulumunga@gmail.com';
    }

    // Multi-center owner/menu/orders data — scoped so only the account that first
    // claims an owner code can ever read or write anything under it.
    match /owners/{ownerCode} {
      // Anyone signed in can check whether a code is free, but only the claimant can be set as owner.
      allow get: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid; // ownership can't be transferred by overwrite

      match /{document=**} {
        allow read, write: if request.auth != null
                            && get(/databases/$(database)/documents/owners/$(ownerCode)).data.ownerUid == request.auth.uid;
      }
    }
  }
}
